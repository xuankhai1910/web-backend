PORT=3000
NODE_ENV=production

# MongoDB Atlas connection string
# Lấy từ Atlas -> Database -> Connect -> Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/web-backend?retryWrites=true&w=majority

# MongoDB Atlas Vector Search for job recommendations
# Create the jobs index first, then switch MONGODB_VECTOR_SEARCH_ENABLED=true.
MONGODB_VECTOR_SEARCH_ENABLED=false
MONGODB_JOB_VECTOR_INDEX=job_embedding_vector_v1
RECOMMEND_VECTOR_RESULT_LIMIT=300
RECOMMEND_VECTOR_NUM_CANDIDATES=5000
RECOMMEND_FALLBACK_CANDIDATE_LIMIT=500

# JWT
JWT_ACCESS_TOKEN_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRE=1h
JWT_REFRESH_TOKEN_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRE=7d

# CORS: danh sách origin cho phép, ngăn cách bởi dấu phẩy
# Ví dụ: https://my-frontend.com,https://admin.my-frontend.com
CORS_ORIGINS=
FRONTEND_URL=http://localhost:5173

# DB init seed (chỉ bật 1 lần khi DB trống, sau đó phải đổi về false)
SHOULD_INIT=false
INIT_PASSWORD=change_me

# Mail
EMAIL_HOST=smtp.gmail.com
EMAIL_AUTH_USER=
EMAIL_AUTH_PASSWORD=
EMAIL_PREVIEW=false

# Google Gemini
GEMINI_API_KEY=
