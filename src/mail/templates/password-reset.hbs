<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>

<body style="margin: 0; padding: 0; background-color: #eef6f5; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;">
    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #eef6f5; padding: 32px 16px;">
        <tr>
            <td align="center">
                <table width="600" cellpadding="0" cellspacing="0" border="0" style="max-width: 600px; width: 100%; background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 24px rgba(15, 118, 110, 0.1);">
                    <tr>
                        <td style="background-color: #0f766e; padding: 28px 32px;">
                            <div style="font-size: 26px; font-weight: 700; color: #ffffff; letter-spacing: -0.5px;">DevMarket</div>
                            <div style="font-size: 13px; color: rgba(255,255,255,0.78); margin-top: 2px;">Bảo mật tài khoản</div>
                        </td>
                    </tr>

                    <tr>
                        <td style="padding: 30px 32px 8px 32px;">
                            <div style="font-size: 18px; font-weight: 600; color: #0f172a;">Xin chào {{receiver}},</div>
                            <div style="font-size: 15px; color: #475569; margin-top: 10px; line-height: 1.65;">
                                Chúng tôi nhận được yêu cầu đặt lại mật khẩu cho tài khoản DevMarket của bạn. Nhấn nút bên dưới để tạo mật khẩu mới.
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td align="center" style="padding: 24px 32px;">
                            <a href="{{resetUrl}}" target="_blank" style="display: inline-block; background-color: #0f766e; color: #ffffff; font-size: 15px; font-weight: 700; text-decoration: none; padding: 13px 34px; border-radius: 8px;">
                                Đặt lại mật khẩu
                            </a>
                        </td>
                    </tr>

                    <tr>
                        <td style="padding: 0 32px 22px 32px;">
                            <div style="font-size: 14px; color: #64748b; line-height: 1.65;">
                                Liên kết này sẽ hết hạn sau {{expiresIn}} và chỉ dùng được một lần. Nếu bạn không yêu cầu đặt lại mật khẩu, vui lòng bỏ qua email này.
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td style="padding: 0 32px 24px 32px;">
                            <div style="font-size: 12px; color: #94a3b8; line-height: 1.6; word-break: break-all;">
                                Nếu nút không hoạt động, hãy mở liên kết sau trong trình duyệt:<br>
                                <a href="{{resetUrl}}" target="_blank" style="color: #0f766e;">{{resetUrl}}</a>
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td style="background-color: #f8fafc; border-top: 1px solid #e2e8f0; padding: 16px 32px;">
                            <div style="font-size: 12px; color: #94a3b8;">
                                &copy; 2026 DevMarket
                            </div>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>

</html>
